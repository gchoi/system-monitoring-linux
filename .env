# Realtime GPU Monitor - Environment Variables

# External Ports
FRONTEND_PORT=3000
BACKEND_PORT=8000

# Force Mock GPU Telemetry (set to 'true' if testing on machines without Nvidia GPUs)
MOCK_GPU=false

# WebSocket Server URL
# If left empty, the frontend will automatically connect to the current browser's host on port 8000.
# Example override: NEXT_PUBLIC_WS_URL=ws://192.168.1.100:8000/ws
NEXT_PUBLIC_WS_URL=
